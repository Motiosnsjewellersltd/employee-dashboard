# Neon pooled PostgreSQL connection string. Use the hostname containing "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler/neondb?sslmode=require"

# Neon direct PostgreSQL connection string. Turn Connection pooling OFF in Neon and copy that URL.
# Prisma CLI uses this for db push/migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"

# Required in production. Generate a long random secret (32+ bytes).
JWT_SECRET="CHANGE_TO_A_LONG_RANDOM_SECRET"

# Your deployed Vercel URL after deployment.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Web Push notifications. Run: npm run vapid:generate
# Add the generated values to both local .env and Vercel Environment Variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="GENERATED_PUBLIC_KEY"
VAPID_PRIVATE_KEY="GENERATED_PRIVATE_KEY"
VAPID_SUBJECT="mailto:your-email@example.com"

# Vercel Blob is connected from Vercel Storage. New stores use OIDC automatically.
# For legacy/local Blob setups only, Vercel may provide BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Used only when running npm run db:seed. Do not commit real values.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_TO_A_STRONG_PASSWORD"
